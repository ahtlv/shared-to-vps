# Блок для общего /opt/stacks/caddy/Caddyfile.
#
# Руками этот файл в общий Caddyfile не вклеивать: для этого есть
# scripts/proxy-apply.sh. На той же машине обычным делом стоят соседние
# площадки, каждая уже продаёт: `docker compose up` на контейнере обратного
# прокси уронил бы их всех разом. Скрипт правит файл, не пересоздавая
# контейнер, и проверяет соседей до и после.
#
# До переключения DNS действует блок http://{{DOMAIN}} ниже, чтобы обратный
# прокси не пытался получить сертификат через старый хостинг: домен пока
# смотрит туда, HTTP-01 ушёл бы не по адресу, и повторные отказы упёрлись бы в
# лимиты Let's Encrypt. Целевой блок с TLS и редиректом www — под ним, закрыт
# комментарием, и включается на Ф5 (переключение).

http://{{DOMAIN}} {
	reverse_proxy {{SLUG}}-nginx:80
}

# Целевой блок после переключения DNS. Раскомментировать и убрать блок выше в
# Ф5, одним заходом со сменой A-записи: старый хостинг у заражённых площадок
# отдаёт HSTS на год, и вернувшийся посетитель не примет http.
#
# {{DOMAIN}}, www.{{DOMAIN}} {
# 	encode zstd gzip
#
# 	@www host www.{{DOMAIN}}
# 	redir @www https://{{DOMAIN}}{uri} permanent
#
# 	reverse_proxy {{SLUG}}-nginx:80
# }
